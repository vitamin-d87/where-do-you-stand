# Supabase Edge Function secrets ONLY. Never use VITE_ for these.
# Hosted Supabase normally supplies SUPABASE_SECRET_KEYS automatically.
# If needed, set APP_SUPABASE_SECRET_KEY to a current sb_secret_... key.
APP_SUPABASE_SECRET_KEY=
# Exact front-end origins (scheme + hostname + port, no path or slash):
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-USERNAME.github.io
# Generate a 64-character random value; also save as GitHub CLEANUP_SECRET.
CLEANUP_SECRET=
